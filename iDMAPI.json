    }
  ],
  "paths": {
    "/GetAllPerm": {
      "get": {
        "summary": "Načtení všech oprávnění",
        "tags": [
          "Uživatelé"
        ],
        "description": "Načtení všech oprávnění.",
        "operationId": "GetAllPerm",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Operace úspěšně dokončena",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllPerm"
                }
              }
            }
          },
          "401": {
            "description": "Chybné uživatelské jméno/heslo"
          }
        }
      }
    },
    "/GetAllUser": {
      "get": {
        "summary": "Načtení všech uživatelů a jejich oprávnění",
        "tags": [
          "Uživatelé"
        ],
        "description": "Načtení všech uživatelů a jejich oprávnění.",
        "operationId": "GetAllUser",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Operace úspěšně dokončena",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllUser"
                }
              }
            }
          },
          "401": {
            "description": "Chybné uživatelské jméno/heslo"
          }
        }
      }
    },
    "/CreateUser": {
      "post": {
        "summary": "Založení nového uživatele",
        "tags": [
          "Uživatelé"
        ],
        "description": "Založení nového uživatele a nastavení práv.",
        "operationId": "CreateUser",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "requestBody": {
          "description": "Založení nového uživatele a nastavení práv.\n\n**Parametry**\n|Název|Popis|Poznámka|\n|-----|-----|--------|\n|userNameBASE64|Název uživatele podle AD|kódováno BASE64 (např. 'test' je 'dGVzdA==')|\n|permissions|Seznam oprávnění|práva oddělená čerkou|\n\n[Online encoder do BASE64 např. zde](https://www.base64encode.org/)\n",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserReq"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK: Uživatel založen.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "$ref": "#/components/schemas/CreateUserResp"
                }
              }
            }
          },
          "400": {
            "description": "Chyba při provádění příkazu",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "$ref": "#/components/schemas/CreateUserResp"
                },
                "examples": {
                  "Nevyplněná položka 'userNameBASE64'": {
                    "value": {
                      "userID": "1234578-1234-1234-1234-1234567901234",
                      "result": "Error: Položka 'userNameBASE64' musí být vyplněná."
                    }
                  },
                  "Nevyplněná položka 'permissions'": {
                    "value": {
                      "userID": "1234578-1234-1234-1234-1234567901234",
                      "result": "Error: Položka 'permissions' musí být vyplněná."
                    }
                  },
                  "Uživatel již existuje": {
                    "value": {
                      "userID": "1234578-1234-1234-1234-1234567901234",
                      "result": "Error: Uživatel již existuje."
                    }
                  },
                  "Nespecifikovaná chyba": {
                    "value": {
                      "userID": "1234578-1234-1234-1234-1234567901234",
                      "result": "Error: Chyba při zakládání uživatele."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Chybné uživatelské jméno/heslo"
          }
        }
      }
    },
    "/UpdateUser": {
      "put": {
        "summary": "Aktualizace práv uživatele",
        "tags": [
          "Uživatelé"
        ],
        "description": "Aktualizace práv uživatele/změna uživatelského jména",
        "operationId": "UpdateUser",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "requestBody": {
          "description": "Aktualizace práv uživatele/změna uživatelského jména\n      \n**Parametry**\n|Název|Popis|Poznámka|\n|-----|-----|--------|\n|userID|Jednoznačný identifikátor uživatele|vrací funkce CreateUser|\n|userNameBASE64|Název uživatele podle AD|kódováno BASE64 (např. 'test' je 'dGVzdA==')|\n|permissions|Seznam oprávnění|práva oddělená čerkou|\n\n* Pokud je parametr 'userNameBASE64' vyplněný, přejmenuje daného uživatele (jinak prázdný).\n* Pokud je parametr 'permissions' prázdný, nastaví uživatele jako blokovaný/deaktivovaný (jinak nastaví zadaná práva).\n\n[Online encoder do BASE64 např. zde](https://www.base64encode.org/)\n",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserReq"
              },
              "examples": {
                "Nastavení práv uživatele": {
                  "value": {
                    "userID": "1234578-1234-1234-1234-1234567901234",
                    "userNameBASE64": "",
                    "permissions": "iGIS_ShowDB,iGIS_ShowRef,EvStan_Login"
                  }
                },
                "Změna uživatelského jména a nastavení práv": {
                  "value": {
                    "userID": "1234578-1234-1234-1234-1234567901234",
                    "userNameBASE64": "nové_uživatelské_jméno_BASE64",
                    "permissions": "iGIS_ShowDB,iGIS_ShowRef,EvStan_Login"
                  }
                },
                "Blokace/deaktivace uživatelského jména": {
                  "value": {
                    "userID": "1234578-1234-1234-1234-1234567901234",
                    "userNameBASE64": "",
                    "permissions": ""
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK: Oprávnění nastavena úspěšně.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "$ref": "#/components/schemas/UpdateUserResp"
                },
                "examples": {
                  "Oprávnění nastavena úspěšně": {
                    "value": {
                      "userID": "1234578-1234-1234-1234-1234567901234",
                      "result": "OK: Oprávnění nastavena úspěšně."
                    }
                  },
                  "Uživatel nastaven jako zablokovaný/deaktivovaný": {
                    "value": {
                      "userID": "1234578-1234-1234-1234-1234567901234",
                      "result": "OK: Uživatel je nastaven jako zablokovaný/deaktivovaný."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Chyba při provádění příkazu",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "$ref": "#/components/schemas/UpdateUserResp"
                },
                "examples": {
                  "Uživatel neexistuje": {
                    "value": {
                      "userID": "1234578-1234-1234-1234-1234567901234",
                      "result": "Error: Uživatel neexistuje."
                    }
                  },
                  "Nespecifikovaná chyba": {
                    "value": {
                      "userID": "1234578-1234-1234-1234-1234567901234",
                      "result": "Error: Chyba při aktualizaci práv."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Chybné uživatelské jméno/heslo"
          }
        }
      }
    },
    "/GetUserIdPerm/{userID}": {
      "get": {
        "summary": "Vrátí seznam oprávnění daného uživatele",
        "tags": [
