                  "permDesc": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": [
          {
            "userID": "Interní ID uživatele - GUID 1",
            "userNameBASE64": "uživatelské_jméno_BASE64 1",
            "permissions": [
              {
                "permName": "právo 1",
                "permDesc": "popis práva 1"
              },
              {
                "permName": "právo 2",
                "permDesc": "popis práva 2"
              }
            ]
          },
          {
            "userID": "Interní ID uživatele - GUID 2",
            "userNameBASE64": "uživatelské_jméno_BASE64 2",
            "permissions": [
              {
                "permName": "právo 1",
                "permDesc": "popis práva 1"
              },
              {
