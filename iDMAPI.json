          "401": {
            "description": "Chybné uživatelské jméno/heslo"
          }
        }
      }
    },
    "/DeleteUser/{userID}": {
      "delete": {
        "summary": "Odstranění uživatele",
        "tags": [
          "Uživatelé"
        ],
        "description": "Odstranění uživatele.",
        "operationId": "DeleteUser",
        "parameters": [
          {
            "name": "userID",
            "in": "path",
            "description": "interní ID uživatele (vrací CreateUser)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "basicAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK: Uživatel by úspěšně odstraněn.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "$ref": "#/components/schemas/UpdateUserResp"
                }
              }
            }
          },
          "400": {
            "description": "Chyba při provádění příkazu",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "$ref": "#/components/schemas/UpdateUserResp"
                },
                "examples": {
                  "Uživatel neexistuje": {
                    "value": {
                      "userID": "1234578-1234-1234-1234-1234567901234",
                      "result": "Error: Uživatel se zadaným ID nebyl nalezen."
                    }
                  },
                  "Nespecifikovaná chyba": {
                    "value": {
                      "userID": "1234578-1234-1234-1234-1234567901234",
                      "result": "Error: Chyba při odstraňování uživatele."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Chybné uživatelské jméno/heslo"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetAllPerm": {
        "type": "array",
        "items": {
          "type": "object",
