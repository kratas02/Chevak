        ],
        "description": "Vrátí seznam oprávnění daného uživatele.",
        "operationId": "GetUserIdPerm",
        "parameters": [
          {
            "name": "userID",
            "in": "path",
            "description": "interní ID uživatele (vrací CreateUser)",
            "required": true,
