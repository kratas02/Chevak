              },
              {
                "permName": "právo 3",
                "permDesc": "popis práva 3"
              }
            ]
          }
        ]
      },
      "CreateUserReq": {
        "type": "object",
        "properties": {
          "userNameBASE64": {
            "type": "string",
            "example": "uživatelské_jméno_BASE64",
            "description": "Uživatelské jméno podle AD (BASE64)"
          },
          "permissions": {
            "type": "string",
            "example": "iGIS_ShowDB,iGIS_ShowRef,EvStan_Login",
            "description": "Seznam oprávnění (oddělovač čárka)"
          }
        }
      },
      "CreateUserResp": {
        "type": "object",
        "properties": {
          "userID": {
            "type": "string",
            "example": "1234578-1234-1234-1234-1234567901234",
            "description": "Interní ID uživatele - GUID"
          },
          "result": {
            "type": "string",
            "example": "OK: Uživatel založen.",
            "description": "Výsledek operace. Vrací 'OK: ...' nebo 'Error: ...'"
          }
        }
      },
      "UpdateUserReq": {
        "type": "object",
        "properties": {
          "userID": {
            "type": "string",
            "example": "uživatelské_ID",
            "description": "Interní ID uživatele - GUID"
          },
          "userNameBASE64": {
            "type": "string",
            "example": "uživatelské_jméno_BASE64",
            "description": "Uživatelské jméno podle AD (vyplněné jen při změně uživatelského jména) (BASE64)"
          },
          "permissions": {
            "type": "string",
            "example": "iGIS_ShowDB,iGIS_ShowRef,EvStan_Login",
            "description": "Seznam oprávnění (oddělovač čárka)"
          }
        }
      },
      "UpdateUserResp": {
        "type": "object",
