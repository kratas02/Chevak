<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!--
      Připojovací řetězec k iDM databázi.
      Upravte Data Source a Initial Catalog dle prostředí.
      Integrated Security=True  → Windows autentizace (účet miiserver.exe služby)
      nebo použijte: User Id=login;Password=heslo;
    -->
    <add name="IDMDatabase"
         connectionString="Data Source=cheapp01;Initial Catalog=EasyIDM;Integrated Security=True;Connect Timeout=30;" />
  </connectionStrings>
</configuration>
